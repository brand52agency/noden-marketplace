# Copy to .env and fill in. Local dev works with just the first two —
# everything else degrades gracefully (clear "not configured" errors)
# until you add real credentials.

DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3200"

# Bitcoin Lightning payments. Which rail is active is set in
# lib/payments/index.ts (ACTIVE_PAYMENT_RAIL) — only fill in the one
# you're actually using.

# Option A: Alby Hub, connected via NWC (self-custodial, no KYC, free).
# Install Alby Hub (https://albyhub.com), create an app connection, and
# paste its nostr+walletconnect:// URI here. Alby Hub must be running
# and connected to its relay whenever a purchase happens — unlike a
# hosted rail, there's a live wallet on the other end of each request.
ALBY_NWC_URL=

# Option B: LNbits. Self-host (https://github.com/lnbits/lnbits) or use
# a paid hosted instance (https://my.lnbits.com). Works identically
# against testnet/regtest for development.
LNBITS_URL=
LNBITS_ADMIN_KEY=

# Option C: OpenNode. Hosted, handles both receiving and payouts. Use
# https://dev.opennode.co for a free fake-sats dev environment before
# going to production (requires identity verification).
OPENNODE_API_KEY=
OPENNODE_ENV=

# /admin/insights — data-driven recommendations via the Claude API
ANTHROPIC_API_KEY=

# Semantic ("fuzzy") listing search. Optional — falls back to
# keyword/category search when unset (see lib/search.ts).
OPENAI_API_KEY=

# Sends an email to getnoden@proton.me for every seller-lead / early-access
# signup (app/api/v1/seller-leads/route.ts). Optional — the lead is always
# saved to the database either way; this just adds the email notification.
# Get a key at https://resend.com (free tier is plenty for this volume).
RESEND_API_KEY=
# Sender must be an address on a domain verified in Resend, e.g. "Noden <hello@getnoden.com>".
EMAIL_FROM=
# Where replies go (defaults to getnoden@proton.me).
EMAIL_REPLY_TO=

# Card payments for credit packs (Stripe). Set these in Vercel, never in the repo.
# Start with TEST-mode values (sk_test_/rk_test_ key, whsec_ from a test-mode webhook endpoint).
# Webhook endpoint: https://shop.getnoden.com/api/stripe/webhook
#   events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.expired, charge.refunded, charge.dispute.created
BILLING_ENABLED=false       # "true" turns the Buy buttons on (also needs STRIPE_SECRET_KEY)
STRIPE_SECRET_KEY=          # restricted key: Checkout Sessions write, Customers write, Charges/PaymentIntents read
STRIPE_WEBHOOK_SECRET=      # whsec_... for the endpoint above
STRIPE_AUTOMATIC_TAX=false  # "true" once Stripe Tax is set up on the account
NEW_BUYER_DAILY_CREDIT_LIMIT=1000   # credits a brand-new buyer can spend per 24h for their first 7 days
NEXT_PUBLIC_SITE_URL=       # defaults to NEXTAUTH_URL, then https://shop.getnoden.com
