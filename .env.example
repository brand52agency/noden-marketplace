# Copy to .env and fill in. Local dev works with just the first two —
# everything else degrades gracefully (clear "not configured" errors)
# until you add real credentials.

DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3200"

# Bitcoin Lightning payments. Which rail is active is set in
# lib/payments/index.ts (ACTIVE_PAYMENT_RAIL) — only fill in the one
# you're actually using.

# Option A: Alby Hub, connected via NWC (self-custodial, no KYC, free).
# Install Alby Hub (https://albyhub.com), create an app connection, and
# paste its nostr+walletconnect:// URI here. Alby Hub must be running
# and connected to its relay whenever a purchase happens — unlike a
# hosted rail, there's a live wallet on the other end of each request.
ALBY_NWC_URL=

# Option B: LNbits. Self-host (https://github.com/lnbits/lnbits) or use
# a paid hosted instance (https://my.lnbits.com). Works identically
# against testnet/regtest for development.
LNBITS_URL=
LNBITS_ADMIN_KEY=

# Option C: OpenNode. Hosted, handles both receiving and payouts. Use
# https://dev.opennode.co for a free fake-sats dev environment before
# going to production (requires identity verification).
OPENNODE_API_KEY=
OPENNODE_ENV=

# /admin/insights — data-driven recommendations via the Claude API
ANTHROPIC_API_KEY=

# Semantic ("fuzzy") listing search. Optional — falls back to
# keyword/category search when unset (see lib/search.ts).
OPENAI_API_KEY=
